# Import required libraries
import pandas as pd
import pyodbc
import nltk
from nltk.sentiment.vader import SentimentIntensityAnalyzer


# ------------------------------------------------------------
# 1. DOWNLOAD VADER LEXICON
# ------------------------------------------------------------

# Download the VADER lexicon required for sentiment analysis
nltk.download('vader_lexicon')


# ------------------------------------------------------------
# 2. CONNECT TO SQL SERVER AND LOAD CUSTOMER REVIEW DATA
# ------------------------------------------------------------

def fetch_data_from_sql():

    # SQL Server connection details
    # Credentials have been replaced with placeholders for GitHub
    conn_str = (
        "DRIVER={ODBC Driver 18 for SQL Server};"
        "SERVER=127.0.0.1,1433;"
        "DATABASE=PortfolioProject_MarketingAnalytics;"
        "UID=YOUR_USERNAME;"
        "PWD=YOUR_PASSWORD;"
        "TrustServerCertificate=yes;"
    )

    # Establish connection
    conn = pyodbc.connect(conn_str)

    # Retrieve cleaned customer review data
    query = """
        SELECT
            ReviewID,
            CustomerID,
            ProductID,
            ReviewDate,
            Rating,
            ReviewText
        FROM customer_reviews_cleaned
    """

    # Load SQL data into a Pandas DataFrame
    customer_reviews = pd.read_sql(query, conn)

    # Close database connection
    conn.close()

    return customer_reviews


# Load customer review data
customer_reviews_df = fetch_data_from_sql()


# ------------------------------------------------------------
# 3. INITIALISE VADER SENTIMENT ANALYSER
# ------------------------------------------------------------

sia = SentimentIntensityAnalyzer()


# ------------------------------------------------------------
# 4. CALCULATE SENTIMENT SCORE
# ------------------------------------------------------------

def calculate_sentiment(review):

    # Calculate sentiment scores for the review text
    sentiment = sia.polarity_scores(review)

    # Return the compound score
    # Range: -1 (most negative) to +1 (most positive)
    return sentiment['compound']


# Apply sentiment analysis to each customer review
customer_reviews_df['SentimentScore'] = (
    customer_reviews_df['ReviewText']
    .apply(calculate_sentiment)
)


# ------------------------------------------------------------
# 5. CREATE SENTIMENT CATEGORIES
# ------------------------------------------------------------

def categorize_sentiment(score, rating):

    # Positive text sentiment
    if score > 0.05:

        if rating >= 4:
            return 'Positive'

        elif rating == 3:
            return 'Mixed Positive'

        else:
            return 'Mixed Negative'


    # Negative text sentiment
    elif score < -0.05:

        if rating <= 2:
            return 'Negative'

        elif rating == 3:
            return 'Mixed Negative'

        else:
            return 'Mixed Positive'


    # Neutral text sentiment
    else:

        if rating >= 4:
            return 'Positive'

        elif rating <= 2:
            return 'Negative'

        else:
            return 'Neutral'


# Apply sentiment categorisation using both
# the VADER sentiment score and customer rating
customer_reviews_df['SentimentCategory'] = customer_reviews_df.apply(
    lambda row: categorize_sentiment(
        row['SentimentScore'],
        row['Rating']
    ),
    axis=1
)


# ------------------------------------------------------------
# 6. CREATE SENTIMENT SCORE BUCKETS
# ------------------------------------------------------------

def sentiment_bucket(score):

    if score >= 0.5:
        return '0.5 to 1.0'

    elif 0.0 <= score < 0.5:
        return '0.0 to 0.49'

    elif -0.5 <= score < 0.0:
        return '-0.49 to 0.0'

    else:
        return '-1.0 to -0.5'


# Apply sentiment buckets
customer_reviews_df['SentimentBucket'] = (
    customer_reviews_df['SentimentScore']
    .apply(sentiment_bucket)
)


# ------------------------------------------------------------
# 7. REVIEW SENTIMENT ANALYSIS RESULTS
# ------------------------------------------------------------

# Display first five rows
print(customer_reviews_df.head())


# Display number of reviews in each sentiment category
print("\nSentiment Category Distribution:")
print(customer_reviews_df['SentimentCategory'].value_counts())


# ------------------------------------------------------------
# 8. EXPORT PROCESSED DATA FOR POWER BI
# ------------------------------------------------------------

# Export the enriched customer review dataset
customer_reviews_df.to_csv(
    'customer_reviews_with_sentiment.csv',
    index=False
)

print("\nSentiment analysis completed successfully.")
print("File saved as: customer_reviews_with_sentiment.csv")
